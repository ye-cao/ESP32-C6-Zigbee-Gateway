{
  "name": "ESP32-C6 Zigbee Gateway",
  "version": "1.2.6",
  "slug": "esp32c6_gateway",
  "description": "Bridges the ESP32-C6 Zigbee coordinator (JSON-Lines over USB-serial) to MQTT + Web UI",
  "url": "https://github.com/gerontec/esp32c6-zigbee-vital-gateway",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "udev": true,
  "host_network": true,
  "map": [
    "share"
  ],
  "options": {
    "serial_port": "/dev/ttyACM0",
    "baud": 115200,
    "mqtt_host": "127.0.0.1",
    "mqtt_port": 1883,
    "mqtt_user": "",
    "mqtt_pass": "",
    "base_topic": "gw/coordinator",
    "web_port": 8082,
    "db_host": "",
    "timezone": "Asia/Shanghai",
    "fw_chunk": 80
  },
  "schema": {
    "serial_port": "device(subsystem=tty)",
    "baud": "int(110,3000000)",
    "mqtt_host": "str",
    "mqtt_port": "int(1,65535)",
    "mqtt_user": "str",
    "mqtt_pass": "password",
    "base_topic": "str",
    "web_port": "int(1,65535)",
    "db_host": "str",
    "timezone": "str",
    "fw_chunk": "int(32,512)"
  }
}

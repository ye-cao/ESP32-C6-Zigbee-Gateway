{
  "name": "ESP32-C6 Zigbee Gateway",
  "version": "1.5.6",
  "slug": "esp32c6_gateway",
  "description": "Bridges the ESP32-C6 Zigbee coordinator to MQTT + Web UI. The link to the coordinator is either USB-serial (JSON-Lines) or Wi-Fi/TCP, where this add-on listens and the board connects in.",
  "url": "https://github.com/gerontec/esp32c6-zigbee-vital-gateway",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "udev": false,
  "uart": true,
  "host_network": true,
  "map": [
    "share"
  ],
  "options": {
    "link": "uart",
    "serial_port": "/dev/ttyACM0",
    "tcp_port": 12345,
    "baud": 115200,
    "mqtt_host": "127.0.0.1",
    "mqtt_port": 1883,
    "mqtt_user": "",
    "mqtt_pass": "",
    "base_topic": "gw/coordinator",
    "web_port": 8082,
    "db_host": "",
    "timezone": "Asia/Shanghai",
    "fw_chunk": 80,
    "topo_interval": 60
  },
  "schema": {
    "link": "list(uart|tcp)",
    "serial_port": "str",
    "tcp_port": "int(1,65535)",
    "baud": "int(110,3000000)",
    "mqtt_host": "str",
    "mqtt_port": "int(1,65535)",
    "mqtt_user": "str",
    "mqtt_pass": "password",
    "base_topic": "str",
    "web_port": "int(1,65535)",
    "db_host": "str",
    "timezone": "str",
    "fw_chunk": "int(32,512)",
    "topo_interval": "int(0,3600)"
  }
}

# ESP32-C6 – Zigbee Coordinator + Radar → UART/USB 或 Wi-Fi/TCP
# Wi-Fi 默认**不启用**（NVS 里 netlink/tr 的默认值是 0 = 串口），
# 但组件编进来是必须的：不编就没法在运行期打开第二条通道。

# ── Zigbee ────────────────────────────────────────────────────────────────────
CONFIG_ZB_ENABLED=y
# ★★★ 角色必须写成 CONFIG_ZB_ZCZR（Coordinator/Router）。
#   原来这里写的是 CONFIG_ZB_COORDINATOR_ROLE —— 那是**不存在的符号**，
#   每次构建都报 `unknown kconfig symbol`，只是靠 Kconfig 的
#   `default ZB_ZCZR` 侥幸生效。干净构建或 Kconfig 默认值一变，角色就会错成
#   终端设备，网关直接失效。2026-11-07 修正。
CONFIG_ZB_ZCZR=y
CONFIG_ZB_GP_ENABLED=n

# ── Wi-Fi（可选的第二条传输通道，见 main/net_link.c）─────────────────────────
# C6 只有一个 2.4 GHz 射频，Wi-Fi 与 802.15.4 必须靠软件时分复用。
# 不开共存的话两个协议会互相把对方的包撞掉，表现为「设备偶尔离线」这种
# 最难查的毛病。信道规划：Zigbee 25 ↔ Wi-Fi 1 或 6，别用 Zigbee 20。
CONFIG_ESP_COEX_ENABLED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_LWIP_MAX_SOCKETS=10
# ★ 原来的 CONFIG_ESP_WIFI_SW_COEXIST_ENABLE 是旧符号，IDF 会提示
#   "was replaced with CONFIG_ESP_COEX_SW_COEXIST_ENABLE"，5.5.2 起已不存在，
#   保留只会产生无意义的警告，故删除（效果由上面那一项覆盖）。

# ★★★ WPA3-SAE 必须显式编进来，而且必须写在这个文件里。
#   sdkconfig 是 .gitignore 掉的，只在本地有效 —— 换台机器干净构建就会丢掉
#   这三项，届时连纯 WPA3 的路由器会一直 STA_DISCONNECTED 且不给任何提示。
#   2026-11-06：家里的 'yecao' 就是 WPA3-个人，栽在这上面。
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
CONFIG_ESP_WIFI_ENABLE_SAE_PK=y
CONFIG_ESP_WIFI_ENABLE_SAE_H2E=y

# ── CPU / System ──────────────────────────────────────────────────────────────
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
# ── OTA 回滚保护（应用侧已就绪，编译开关暂不打开）────────────────────────
# serial_ota.c 用标准 esp_ota_*，新镜像会被标成 PENDING_VERIFY；开启下面这一项
# 后，应用必须在首启确认健康，否则 bootloader 会回滚回旧镜像。
# main.c::app_main() 末尾已经实现首启自检（仅在 PENDING_VERIFY 时调用
# esp_ota_mark_app_valid_cancel_rollback()），代码与开关解耦，随时可以启用。
# ★ 2026-11-07 暂不开启的原因：改 sdkconfig 会让 IDF 重新生成 sdkconfig.h，
#   触发 1030 个 obj 的全量重编译；本机 Windows Defender 实时扫描下实测
#   20 分钟只推进 19 个 obj，构建不可控。等能关掉实时防护或换构建机再启用。
#   启用前请确认 bootloader.bin 也一起重新刷写，否则只有应用侧逻辑生效。
# CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# ── 控制台走 USB Serial JTAG（/dev/ttyACM0）────────────────────────────────
# 注意：ESP_LOGI 等日志在 ha_mqtt_init() 里被 null_vprintf 静默掉，
# 串口上只剩 JSON 行；排查内部状态请看 net_status / 各设备的回执。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── Flash / Partition Table ───────────────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── NVS ───────────────────────────────────────────────────────────────────────
CONFIG_NVS_ENCRYPTION=n

# ── Logging ───────────────────────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

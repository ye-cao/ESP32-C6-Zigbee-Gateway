# ESP32-C6 – Zigbee Coordinator + Radar → UART/USB 或 Wi-Fi/TCP
# Wi-Fi 默认**不启用**（NVS 里 netlink/tr 的默认值是 0 = 串口），
# 但组件编进来是必须的：不编就没法在运行期打开第二条通道。

# ── Zigbee ────────────────────────────────────────────────────────────────────
CONFIG_ZB_ENABLED=y
CONFIG_ZB_COORDINATOR_ROLE=y
CONFIG_ZB_GP_ENABLED=n

# ── Wi-Fi（可选的第二条传输通道，见 main/net_link.c）─────────────────────────
# C6 只有一个 2.4 GHz 射频，Wi-Fi 与 802.15.4 必须靠软件时分复用。
# 不开共存的话两个协议会互相把对方的包撞掉，表现为「设备偶尔离线」这种
# 最难查的毛病。信道规划：Zigbee 25 ↔ Wi-Fi 1 或 6，别用 Zigbee 20。
CONFIG_ESP_COEX_ENABLED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SW_COEXIST_ENABLE=y
CONFIG_LWIP_MAX_SOCKETS=10

# ★★★ WPA3-SAE 必须显式编进来，而且必须写在这个文件里。
#   sdkconfig 是 .gitignore 掉的，只在本地有效 —— 换台机器干净构建就会丢掉
#   这三项，届时连纯 WPA3 的路由器会一直 STA_DISCONNECTED 且不给任何提示。
#   2026-11-06：家里的 'yecao' 就是 WPA3-个人，栽在这上面。
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
CONFIG_ESP_WIFI_ENABLE_SAE_PK=y
CONFIG_ESP_WIFI_ENABLE_SAE_H2E=y

# ── CPU / System ──────────────────────────────────────────────────────────────
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# ── 控制台走 USB Serial JTAG（/dev/ttyACM0）────────────────────────────────
# 注意：ESP_LOGI 等日志在 ha_mqtt_init() 里被 null_vprintf 静默掉，
# 串口上只剩 JSON 行；排查内部状态请看 net_status / 各设备的回执。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── Flash / Partition Table ───────────────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── NVS ───────────────────────────────────────────────────────────────────────
CONFIG_NVS_ENCRYPTION=n

# ── Logging ───────────────────────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

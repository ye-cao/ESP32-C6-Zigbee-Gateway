build/
sdkconfig
managed_components/
.cache/
*.bin
!firmware/*.bin
*.elf
*.map
dependencies.lock
*.pyc

# Python-Bytecode – nichts davon gehoert ins Repo oder ins Add-on
__pycache__/

# Klon der Z2M-Converter – nur Eingabe fuer gen_device_db.py
.zhc/

# Klon von Koenkk/zigbee2mqtt – reine Referenz fuer die MQTT-Schicht (s. Report §19)
.z2m/

# Klon von tostmann/esp-coordinator – Referenz fuer Kapazitaet/NVRAM (s. Report §23)
.tostmann/

# Lokale Testumgebung (websockets fuer ha_ws.py)
.mqttenv/

# 项目工作数据（WorkBuddy 记忆/日志）——绝不上传
.workbuddy/

# HA 长期令牌只落在本地临时文件（ha_addon_log.py / ha_ws.py 读取）
_ha_token.tmp

# 临时日志
*.log

# 整片 Flash 备份（含 Zigbee 配网凭据，体积大，不入库）
backup/

# 本地构建配置与多版本构建目录（不进版本库）
build*/
sdkconfig.*
!sdkconfig.defaults

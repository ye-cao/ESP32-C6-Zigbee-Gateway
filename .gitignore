build/
sdkconfig
managed_components/
.cache/
*.bin
!firmware/*.bin
*.elf
*.map
dependencies.lock
*.pyc

# Python 字节码缓存：仓库和 add-on 里都不应出现
__pycache__/

# Z2M 转换器克隆：只作为 gen_device_db.py 的输入源
.zhc/

# zigbee2mqtt 克隆：MQTT 层的纯参考资料（见接入报告 §19）
.z2m/

# esp-coordinator 克隆：容量/NVRAM 参考资料（见接入报告 §23）
.tostmann/

# 本地测试环境（ha_ws.py 用的 websockets 依赖）
.mqttenv/

# 项目工作数据（WorkBuddy 记忆/日志）——绝不上传
.workbuddy/

# HA 长期令牌只落在本地临时文件（ha_addon_log.py / ha_ws.py 读取）
_ha_token.tmp

# 临时日志
*.log

# 整片 Flash 备份（含 Zigbee 配网凭据，体积大，不入库）
backup/

# 本地构建配置与多版本构建目录（不进版本库）
build*/
sdkconfig.*
!sdkconfig.defaults
_commit_msg.tmp
